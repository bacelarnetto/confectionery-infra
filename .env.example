# ============================================================
# ConfectioneryEase — variáveis de ambiente (template)
# Copie para .env e preencha com valores REAIS. O .env é
# gitignored — nunca versionar credenciais reais.
# ============================================================

# --- PostgreSQL ----------------------------------------------
# Container postgres-confectionery-db (docker-compose.yaml)
POSTGRES_DB=confectionery
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

# Credenciais da API (application-*.yaml) -- no compose local, as mesmas do container acima.
# DB_URL só é lido pelos profiles dev/prod (docker usa o host interno fixo do compose).
DB_URL=jdbc:postgresql://localhost:5432/confectionery
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_POSTGRES

# --- Keycloak ------------------------------------------------
# Admin do realm MASTER (bootstrap do container, não o user de negócio do realm confectionery)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN

# Secret do client confectionery-server (Admin REST / provisionamento de usuário).
# Deve ser rotacionado no realm após o import (doc/seguranca-e-vulnerabilidades.md).
CONFECTIONERY_SERVER_CLIENT_SECRET=CHANGE_ME_SERVER_CLIENT_SECRET

# jwk-set-uri do Keycloak em PRODUÇÃO (endpoint de certificados do realm) -- exigido só no profile
# "prod" (application-prod.yaml); sem valor o app falha no boot com erro de placeholder ausente
# (decisão deliberada, ver doc/PROJECT_CONTEXT.md item 42). dev/docker já têm seu próprio
# jwk-set-uri fixo (localhost:8180 / keycloak:8080) e não usam esta variável.
APP_SECURITY_JWT_JWK_SET_URI=CHANGE_ME_https://<keycloak-host>/realms/confectionery/protocol/openid-connect/certs

# --- Notificação (outbox transacional + Web Push local) --------------------------------------
# 2026-09-29: a app separada `confectionery-notificacoes` foi abandonada (decisão do dono, ver
# doc/requisito-notificacao-push-interno-abandonar-notificacoes-app.md) -- o Web Push agora é
# enviado DIRETO pelo monólito (PushEnvioAdapter), sem HTTP para outro processo. O outbox
# transacional continua (garante que o alerta não se perde).

# Telefone da dona (canal WHATSAPP do outbox) em E.164, só dígitos: 55 + DDD + número (ex.: 5511986174138).
# Sem essa variável o NotificacaoAlertaListener pula só o enfileiramento WHATSAPP (o canal PUSH
# continua funcionando normalmente, independente do telefone).
# Feature flag do WhatsApp (pausado; true só quando houver remetente/provedor definido)
APP_NOTIFICACAO_WHATSAPP_ENABLED=false
APP_NOTIFICACAO_DONA_TELEFONE=CHANGE_ME_5511XXXXXXXXX

# Interruptor mestre de TODA a feature de notificação (antes APP_NOTIFICACAO_API_ENABLED, quando
# ainda existia um cliente HTTP para a app separada). false = outbox não enfileira nada e o worker
# fica no-op -- útil pra rodar sem push configurado.
APP_NOTIFICACAO_ENABLED=false
# Intervalo do scheduler do worker do outbox (ms) e tamanho do lote/tentativas por rodada.
APP_NOTIFICACAO_OUTBOX_INTERVALO_MS=10000
APP_NOTIFICACAO_OUTBOX_LOTE=10
APP_NOTIFICACAO_OUTBOX_MAX_TENTATIVAS=5

# --- Push (Web Push / VAPID) -----------------------------------------------------------------
# Par VAPID gerado 1x: a chave PÚBLICA entra aqui (servida em GET /push-subscription/vapid-public-key)
# e no .env do frontend-deploy. A chave PRIVADA (segredo -- nunca commitar/compartilhar) e o
# subject (contato "mailto:..." exigido pelo RFC 8292) agora também ficam aqui: o próprio monólito
# assina/cifra e faz o POST ao endpoint do navegador (RFC 8291/8292), sem mais uma segunda app
# guardando a privada.
APP_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_BASE64URL
APP_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME_BASE64URL_SEGREDO
APP_PUSH_VAPID_SUBJECT=mailto:suporte@confectionery.com.br
# true (default) = loga e responde sucesso simulado, sem POST real ao navegador. false = envio real
# (exige o par VAPID acima configurado).
APP_PUSH_MOCK=true